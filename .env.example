# 环境配置文件 - 复制为 .env 并填入实际值

# 项目配置
PROJECT_NAME=材料学院智能学习平台
DEBUG=true

# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=material_learning

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530

# MinIO 对象存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 智谱 AI 配置
# 获取 API Key: https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key-here

# 对话模型选择:
# - glm-4-flash: 免费，速度快，适合日常问答 (推荐)
# - glm-4-air: 0.001元/千tokens，性价比高，适合批量处理
# - glm-4-plus: 0.05元/千tokens，能力最强，适合复杂推理
# - glm-4v-plus: 0.01元/千tokens，多模态，支持图像理解
ZHIPU_MODEL=glm-4-flash

# Embedding 模型 (智谱官方)
ZHIPU_EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSION=1024

# JWT 配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
